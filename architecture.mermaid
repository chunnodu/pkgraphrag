flowchart TB
    classDef source    fill:#dce8f8,stroke:#4a80d4,stroke-width:1.5px,color:#1a1a1a
    classDef ingest    fill:#d8f0d8,stroke:#5aaa5a,stroke-width:1.5px,color:#1a1a1a
    classDef storage   fill:#fdefc8,stroke:#e8b84b,stroke-width:1.5px,color:#1a1a1a
    classDef retrieval fill:#fdd8dc,stroke:#e05c6e,stroke-width:1.5px,color:#1a1a1a
    classDef fusion    fill:#e8d8f8,stroke:#9b5fcf,stroke-width:2px,color:#1a1a1a
    classDef graph     fill:#d8f0d8,stroke:#5aaa5a,stroke-width:1.5px,color:#1a1a1a
    classDef llm       fill:#fde0cc,stroke:#e87a2e,stroke-width:1.5px,color:#1a1a1a
    classDef output    fill:#dce8f8,stroke:#4a80d4,stroke-width:1.5px,color:#1a1a1a

    %% ── INGESTION PIPELINE (build-time) ----------------------------------───
    subgraph INGEST["Ingestion Pipeline  (build-time)"]
        direction TB
        MM["Freeplane .mm Maps\n-----------------\n10 active domains\n41,868 nodes total"]
        PARSE["parse_mm_to_rdf.py\n-----------------\n.mm XML to RDF triples\nskos:Concept hierarchy\npkg: custom types"]
        LOD["lod_enrich.py\n-----------------\nowl:sameAs links\nDBpedia / Wikidata\n63 concepts enriched"]
        EMBED["embed_to_lancedb.py\n-----------------\nBAAI/bge-small-en-v1.5\n384-dim, ONNX\n+ FTS index on labels"]

        MM --> PARSE
        PARSE --> LOD
        PARSE --> EMBED
    end

    %% ── STORAGE LAYER ---------------------------------------------------─────
    subgraph STORE["Storage Layer"]
        direction LR
        TTL["RDF Graph (rdflib)\n-----------------\n142,796 triples\n27,776 concepts\n11 TTL files"]
        VDB["LanceDB\n-----------------\n31,983 vectors, 85 MB\ncosine similarity index\n+ FTS inverted index"]
    end

    %% ── QUERY PIPELINE (runtime) ----------------------------------───────────
    subgraph QUERY["Query Pipeline  (retrieve.py + ask.py, runtime)"]
        direction TB
        NLQ["Natural Language Question"]

        subgraph PATHS["Parallel Retrieval Paths"]
            direction LR
            VEC["SemanticRetriever\n-----------------\nfastembed cosine search\ntop-20 by similarity\nFuzzy / semantic match"]
            KW["KeywordRetriever\n-----------------\nLanceDB FTS on labels\ntop-20 by BM25\nExact / acronym match"]
        end

        RRF["rrf_fuse()\n-----------------\nscore = 1 div (60 + rank)\nParameter-free fusion\ntop-8 URIs"]

        GRAPH["GraphRetriever (SPARQL)\n-----------------\nParent, children, siblings\nPersonal notes\nWeb resources, LOD links"]

        CTX["Context Block\n-----------------\nStructured plain-text\nSource map provenance\nVector+keyword flags"]

        LLM["Claude Haiku\n-----------------\nclaude-haiku-4-5-20251001\nAnswers from context only\nFlags thin coverage"]

        ANS["Grounded Answer\n-----------------\n20/20 Q&A passing\n~4.4s end-to-end\nInput + output token stats"]

        NLQ --> VEC
        NLQ --> KW
        VEC --> RRF
        KW  --> RRF
        RRF --> GRAPH
        GRAPH --> CTX
        CTX --> LLM
        LLM --> ANS
    end

    %% ── CROSS-LANE EDGES ---------------------------------------------------──
    LOD  -- "owl:sameAs triples" --> TTL
    PARSE -- "RDF triples" --> TTL
    EMBED -- "vectors + FTS index" --> VDB
    TTL  -- "in-memory graph" --> GRAPH
    VDB  -- "vector neighbours" --> VEC
    VDB  -- "FTS matches" --> KW

    %% ── STYLES ---------------------------------------------------────────────
    class MM source
    class PARSE,LOD,EMBED ingest
    class TTL,VDB storage
    class VEC,KW retrieval
    class RRF fusion
    class GRAPH graph
    class LLM llm
    class NLQ,CTX,ANS output
